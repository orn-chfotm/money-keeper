PORT=4000
DATABASE_URL=postgres://money_keeper:money_keeper@localhost:5432/money_keeper
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000
# Host port for the local PostgreSQL container (docker compose)
DB_PORT=5432
# Required for tests: database name must end with "_test" (tests TRUNCATE its tables)
TEST_DATABASE_URL=postgres://money_keeper:money_keeper@localhost:5432/money_keeper_test
